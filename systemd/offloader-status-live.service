[Unit]
Description=Offloader-Statusseite: Live-Status (live.json)
After=network-online.target nftables.service
Wants=network-online.target

[Service]
User=offloader-status
Group=offloader-status
ExecStart=/opt/offloader-status/bin/offloader-status-live
Restart=always
RestartSec=10
# wg show und nft list counters brauchen CAP_NET_ADMIN, ping CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
